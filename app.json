{
  "expo": {
    "name": "RF Gun App",
    "slug": "rf-gun",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/delphys7-icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "infoPlist": {
        "NSCameraUsageDescription": "This app needs camera access to detect boxes."
      },
      "supportsTablet": true
    },
    "android": {
      "permissions": ["CAMERA"],
      "softwareKeyboardLayoutMode": "adjustResize",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/delphys7-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": false,
      "package": "com.qsitdev.rfgun"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "ac752140-78c5-4ed5-bf53-c21b22f75017"
      }
    },
    "owner": "qsitdev"
  }
}
